# Keep this file free of real secrets. Copy it to .env and edit locally.

# Local-only launch (recommended first run)
HARNESS_BIND=127.0.0.1
HARNESS_PORT=8765

# Windows project roots are separated with semicolons.
HARNESS_PROJECT_ROOTS=D:\Projects
HARNESS_DATA_DIR=D:\Projects\SuperLocal-Harness\data

# Required if HARNESS_BIND is 0.0.0.0 or a Tailscale IP.
# Generate a long random value; do not reuse an account password.
HARNESS_ACCESS_TOKEN=

HARNESS_MAX_WORKERS=2
HARNESS_DAILY_BUDGET_USD=5.00
HARNESS_MISSION_BUDGET_USD=1.00
HARNESS_REQUEST_TIMEOUT_SECONDS=180

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Prices intentionally default to unknown (0). Enter current provider prices
# before relying on USD budget enforcement. Token usage is still recorded.
DEEPSEEK_FLASH_INPUT_PER_M=0
DEEPSEEK_FLASH_OUTPUT_PER_M=0
DEEPSEEK_REASONER_INPUT_PER_M=0
DEEPSEEK_REASONER_OUTPUT_PER_M=0

# Ollama / local OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CODER_MODEL=qwen3-coder:30b
OLLAMA_FAST_MODEL=qwen3:8b

# Optional LiteLLM gateway
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=auto

# Leave the offline demo model on until installation is verified.
HARNESS_ENABLE_MOCK=true
